
int utaraMerah = 2, utaraKuning = 3, utaraHijau = 4;
int timurMerah = 5, timurKuning = 6, timurHijau = 7;
int selatanMerah = 8, selatanKuning = 9, selatanHijau = 10;
int baratMerah = 11, baratKuning = 12, baratHijau = 13;
void semuaMerah() {
  digitalWrite(utaraMerah, HIGH);
  digitalWrite(timurMerah, HIGH);
  digitalWrite(selatanMerah, HIGH);
  digitalWrite(baratMerah, HIGH);

  digitalWrite(utaraHijau, LOW);
  digitalWrite(timurHijau, LOW);
  digitalWrite(selatanHijau, LOW);
  digitalWrite(baratHijau, LOW);

  digitalWrite(utaraKuning, LOW);
  digitalWrite(timurKuning, LOW);
  digitalWrite(selatanKuning, LOW);
  digitalWrite(baratKuning, LOW);
}

void aktifkanSimpang(int merah, int kuning, int hijau) {
  semuaMerah();

  // Hijau nyala
  digitalWrite(merah, LOW);
  digitalWrite(hijau, HIGH);
  delay(5000);

  digitalWrite(hijau, LOW);

  // Kuning kedip 3x
  for (int i = 0; i < 3; i++) {
    digitalWrite(kuning, HIGH);
    delay(666);
    digitalWrite(kuning, LOW);
    delay(666);
  }

  digitalWrite(merah, HIGH);
}

void setup() {
  for (int i = 2; i <= 13; i++) {
    pinMode(i, OUTPUT);
  }
  semuaMerah();
}

void loop() {
  aktifkanSimpang(utaraMerah, utaraKuning, utaraHijau); // Utara
  aktifkanSimpang(timurMerah, timurKuning, timurHijau); // Timur
  aktifkanSimpang(selatanMerah, selatanKuning, selatanHijau); // Selatan
  aktifkanSimpang(baratMerah, baratKuning, baratHijau); // Barat
}
